{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/catalyst/contracts/catalyst-workbench-session-request-v1.schema.json",
  "title": "Catalyst manual workbench session request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "deploymentMode"
  ],
  "properties": {
    "contractVersion": {
      "const": "catalyst.workbench.session.request.v1"
    },
    "deploymentMode": {
      "const": "demo"
    },
    "question": {
      "type": "string",
      "description": "Omit to open an empty session: named and grounded in a data source, with nothing asked of a model yet."
    },
    "profileId": {
      "type": "string",
      "pattern": "^catalyst-query-",
      "minLength": 1
    },
    "dataSourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "browserState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expanded": {
          "type": "boolean"
        },
        "testName": {
          "type": "string"
        },
        "patientId": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "sqlWrapLines": {
          "type": "boolean"
        },
        "editorDraft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseVersionId",
            "question",
            "instruction",
            "sql",
            "parameters",
            "editorOpen"
          ],
          "properties": {
            "baseVersionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "question": {
              "type": "string"
            },
            "instruction": {
              "type": "string"
            },
            "sql": {
              "type": "string"
            },
            "parameters": {
              "$ref": "catalyst-workbench-session-v1.schema.json#/$defs/draftSeed/properties/parameters"
            },
            "editorOpen": {
              "type": "boolean"
            }
          }
        },
        "savedQueryOrigin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "versionId",
            "title",
            "dataSourceId",
            "dialect",
            "previousSessionId"
          ],
          "properties": {
            "versionId": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "dataSourceId": {
              "type": "string",
              "minLength": 1
            },
            "dialect": {
              "type": [
                "string",
                "null"
              ]
            },
            "previousSessionId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
